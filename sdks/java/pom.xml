<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- groupId uses the io.github.<username> namespace, which Maven Central grants
       automatically tied to GitHub identity, with no domain ownership required.
       This intentionally differs from the SDK's actual Java package (dev.relayhub.sdk,
       unchanged below and in every source file): groupId is purely the Maven
       Central publishing coordinate, the package name is what code actually
       imports, and Central only requires the former to match a verified
       namespace. If dev.relayhub is registered as an owned domain later, this
       can be migrated to dev.relayhub with a version bump. -->
  <groupId>io.github.Sksahilkhan67sh</groupId>
  <artifactId>relayhub-sdk</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>RelayHub Java SDK</name>
  <description>Official Java SDK for the RelayHub webhook and event delivery API.</description>
  <url>https://relayhub.dev</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Sahil Khan</name>
      <email>sahilkhan67sh@gmail.com</email>
      <organization>RelayHub</organization>
      <organizationUrl>https://relayhub.dev</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Sksahilkhan67sh/RelayHub.git</connection>
    <developerConnection>scm:git:https://github.com/Sksahilkhan67sh/RelayHub.git</developerConnection>
    <url>https://github.com/Sksahilkhan67sh/RelayHub</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.1</jackson.version>
  </properties>

  <dependencies>
    <!-- Only dependency: JSON (de)serialization. HTTP itself uses java.net.http.HttpClient
         (built into the JDK since 11), so this is the SDK's sole external dependency. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Maven Central requires a -sources.jar and -javadoc.jar alongside the
           main jar for every published artifact; these two plugins produce them. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Signs every artifact (jar, sources jar, javadoc jar) with your GPG key,
           required by Maven Central. keyname is a placeholder: replace with your
           real key ID (run `gpg -K` and use the ID after "sec rsaXXXX/"),
           and never commit gpg.passphrase in plaintext; pass it as a CLI flag
           at build time or via your gitignored ~/.m2/settings.xml, not this file. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.1</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <keyname>15D9A114191C0947</keyname>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Uploads the signed bundle to Sonatype's Central Portal (the only
           working publish path since OSSRH was fully retired in June 2025).
           serverId must match a <server> block with your Central Portal user
           token in ~/.m2/settings.xml; see the README for the exact steps.
           autoPublish is deliberately false: after upload, review the
           deployment on central.sonatype.com and click Publish yourself the
           first time, rather than auto-publishing something unreviewed. -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.6.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>false</autoPublish>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
