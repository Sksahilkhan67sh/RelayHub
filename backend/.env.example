# RelayHub backend -- environment template.
#
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# Every variable below is actually read by app/core/config.py (Settings) --
# nothing here is invented. Fields with no default in config.py are marked
# REQUIRED; everything else has a safe default and is optional to override.

# ---------------------------------------------------------------------------
# APP (server-side, non-secret)
# ---------------------------------------------------------------------------
ENV=development
# development | staging | production. Controls: FastAPI /docs exposure (disabled
# in production, see app/main.py), the security-headers middleware's HSTS header
# (production only), and the `environment` value written into audit log context.
DEBUG=false
APP_NAME=RelayHub
API_V1_PREFIX=/v1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AUTH / SECRETS (never commit real values)
# ---------------------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
PASSWORD_HASH_SCHEME=bcrypt
# NOTE: this setting is declared but not currently read anywhere else in the
# codebase -- app/core/security.py hardcodes bcrypt via passlib directly.
# Documented here as-is rather than silently dropped or wired up (Phase E scope
# is auditing/hardening what exists, not changing behavior).

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
INVITATION_TOKEN_EXPIRE_DAYS=7

# REQUIRED. Base64, 32-byte Fernet/AES envelope-encryption master key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# REQUIRED. Async SQLAlchemy URL -- must be postgresql+asyncpg:// in production
# (no SQLite fallback in production config; SQLite is only used by the test suite).
DATABASE_URL=postgresql+asyncpg://relayhub:relayhub@postgres:5432/relayhub
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# REDIS / CELERY
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------------------
# CORS / PUBLIC-FACING
# ---------------------------------------------------------------------------
# JSON array of allowed origins. Must be the real frontend origin(s) in
# production -- CORS is combined with allow_credentials=True in app/main.py, so
# this must never be "*".
CORS_ORIGINS=["http://localhost:3000"]
# Used to build links embedded in transactional emails (password reset, invite).
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GITHUB OAUTH ("Continue with GitHub" login) -- SECRET (client secret)
# ---------------------------------------------------------------------------
# Optional. Leave GITHUB_OAUTH_CLIENT_ID blank to disable -- the button/endpoints
# return a clear 404 rather than erroring, no other config here is required in
# that case. Create the OAuth App at https://github.com/settings/developers ;
# its "Authorization callback URL" must exactly match GITHUB_OAUTH_REDIRECT_URI.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
DEFAULT_RATE_LIMIT_PER_MIN=100

# ---------------------------------------------------------------------------
# OUTBOUND WEBHOOK DELIVERY / SSRF PROTECTION
# ---------------------------------------------------------------------------
BLOCK_PRIVATE_IP_TARGETS=true
# Set to false in production: allowing http:// (not just https://) endpoint
# targets is a dev convenience only.
ALLOW_HTTP_ENDPOINTS_IN_DEV=true

# ---------------------------------------------------------------------------
# STRIPE (billing) -- SECRET
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# EMAIL (Resend HTTP API -- used by the notification dispatcher for
# password-reset/invite/alert emails). Was SMTP; switched because Render (and
# many other PaaS free tiers) block outbound SMTP ports at the network level,
# so smtplib failed with "Network is unreachable" no matter how correct the
# credentials were. Get an API key at https://resend.com/api-keys -- SECRET
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=RelayHub <alerts@relayhub.dev>

# ---------------------------------------------------------------------------
# AI (Insights AI analysis + Copilot chat) -- SECRET (API keys)
# ---------------------------------------------------------------------------
# Provider-agnostic AI gateway -- see backend/app/modules/ai_gateway/ and
# docs/ai/providers.md. Disabled by default; every deterministic feature
# (delivery, retries, DLQ, RCA, health/anomaly detection) works with AI off.
AI_PROVIDER_ENABLED=false
# Primary provider. One of: anthropic | openai | gemini | xai
AI_PROVIDER=anthropic
# Primary provider's API key and model (used for AI_PROVIDER=anthropic, or as a
# fallback source for whichever provider AI_PROVIDER names -- see
# ai_gateway/gateway.py's _resolve_credentials for the exact precedence).
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=claude-sonnet-4-6
AI_PROVIDER_TIMEOUT_SECONDS=20
AI_PROVIDER_MAX_TOKENS=1000

# Optional automatic fallback provider on transient failure (timeout/rate-limit/
# unavailable only -- never on auth or invalid-request errors). Empty = disabled.
AI_FALLBACK_PROVIDER=

# Per-provider credentials/models. Only the ones actually used (as AI_PROVIDER
# and/or AI_FALLBACK_PROVIDER) need real values.
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-1.5-pro
AI_XAI_API_KEY=
AI_XAI_MODEL=grok-2-latest

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
# Declared but not currently wired to any instrumentation -- see
# docs/architecture/README.md. Setting this alone does not enable tracing;
# leave blank until real OTEL instrumentation is added.
OTEL_EXPORTER_OTLP_ENDPOINT=
